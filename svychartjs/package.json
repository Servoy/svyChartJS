    "@angular/forms": "22.1.2",
    "@energiency/chartjs-plugin-piechart-outlabels": "1.3.5",
    "@servoy/public": "2026.9.2",
    "chart.js": "4.5.1",
    "chart.js-plugin-labels-dv": "5.0.1-beta",
    "chartjs-adapter-luxon": "1.3.1",
    "chartjs-chart-funnel": "4.2.5",
    "chartjs-chart-treemap": "4.2.0",
    "chartjs-plugin-annotation": "^3.1.0",
    "chartjs-plugin-datalabels": "2.2.0",
    "luxon": "3.7.2",
    "ng2-charts": "10.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "22.1.4",
    "@angular/compiler-cli": "22.1.2",
    "@angular/platform-browser": "22.1.2",
    "@eslint/js": "^10.0.1",
    "@types/luxon": "^3.7.4",
    "adm-zip": "0.6.0",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-only-warn": "1.2.1",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^30.0.1",
    "ng-packagr": "22.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true,
    "esbuild@0.28.2": true,
